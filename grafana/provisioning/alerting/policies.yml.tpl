# Сгенерировано run.sh из policies.yml.tpl — не редактируйте этот файл,
# он перезаписывается при каждом запуске.
# =====================================================================
#  Политика уведомлений (Grafana unified alerting)
# =====================================================================
#  Файл создаётся, только если в .env заданы TELEGRAM_BOT_TOKEN и
#  TELEGRAM_CHAT_ID (то есть когда уведомления включены). Без них Grafana
#  использует свою политику по умолчанию, а правила алертов продолжают
#  считаться и остаются видны в интерфейсе.
#
#  Все алерты уходят в контакт-поинт telegram (contact-points.yml).
#  Группировка по имени алерта и ИБП: одно сообщение на устройство,
#  а не общий поток.
# =====================================================================

apiVersion: 1

policies:
  - orgId: 1
    receiver: telegram
    group_by: ['alertname', 'ups_name']
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
    routes:
      # Критичное (нет связи, работа от батареи) — сообщаем быстрее и чаще
      - receiver: telegram
        object_matchers:
          - ['severity', '=', 'critical']
        group_wait: 10s
        group_interval: 2m
        repeat_interval: 1h
