        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count(upsOutputSource{job=\"snmp\", site=~\"$site\"} == 5) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 1001,
      "type": "stat",
      "title": "Нет связи — новые за сутки",
      "description": "ИБП, которые не отвечают по SNMP сейчас, но были на связи в последние 24 часа. Это то, на что стоит посмотреть: выключили, пропала сеть, сломалась карта.",
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
