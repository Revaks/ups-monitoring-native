      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count((up{job=\"snmp\", site=~\"$site\"} == 0) and on (instance) (max_over_time(up{job=\"snmp\", site=~\"$site\"}[1d]) == 1)) or vector(0)",
