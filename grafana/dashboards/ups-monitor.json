    {
      "id": 1004,
      "type": "stat",
      "title": "Мин. автономия",
      "description": "ИБП с самым коротким расчётным временем работы от батареи (upsEstimatedMinutesRemaining). Меньше 10 минут — красный (как в алерте), меньше 20 — жёлтый.",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#FF5B45",
                "value": null
              },
              {
                "color": "#F5B841",
                "value": 10
              },
              {
                "color": "transparent",
                "value": 20
              }
            ]
          },
          "unit": "suffix: мин",
          "displayName": "${__field.labels.instance}"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "bottomk(1, max by (instance) (upsEstimatedMinutesRemaining{job=\"snmp\", site=~\"$site\"}))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 1005,
      "type": "stat",
      "title": "Требует внимания",
      "description": "Только то, что нужно проверить сейчас: работа от батареи, низкий заряд, новое «нет связи» за сутки, перегрузка (> 85 %), перегрев (> 40 °C), байпас, тревога ИБП. Давние «нет связи» сюда не попадают. До 8 ИБП, важное — первым.",
      "gridPos": {
        "h": 7,
        "w": 15,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "в норме",
                  "color": "rgba(128, 128, 128, 0.16)",
                  "index": 0
                },
                "10": {
                  "text": "давно без связи",
                  "color": "#5C4A1E",
                  "index": 1
                },
                "21": {
                  "text": "тревога ИБП",
                  "color": "#F5B841",
                  "index": 2
                },
                "22": {
                  "text": "байпас",
                  "color": "#F5B841",
                  "index": 3
                },
                "23": {
                  "text": "перегрев",
                  "color": "#F5B841",
                  "index": 4
                },
                "24": {
                  "text": "перегрузка",
                  "color": "#F5B841",
                  "index": 5
                },
                "30": {
                  "text": "нет связи",
                  "color": "#F5B841",
                  "index": 6
                },
                "40": {
                  "text": "низкий заряд",
                  "color": "#FF5B45",
                  "index": 7
                },
                "50": {
                  "text": "от батареи",
                  "color": "#FF5B45",
                  "index": 8
                }
              }
            }
          ],
          "noValue": "новых проблем нет",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "unit": "short",
          "displayName": "${__field.labels.instance} · ${__field.labels.site}"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true,
        "text": {
          "valueSize": 22
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "label_replace(sort_desc(topk(8, (\nmax by (instance, site) (upsOutputSource{job=\"snmp\", site=~\"$site\"} == 5) * 0 + 50\nor max by (instance, site) (upsBatteryStatus{job=\"snmp\", site=~\"$site\"} >= 3) * 0 + 40\nor max by (instance, site) ((up{job=\"snmp\", site=~\"$site\"} == 0) and on (instance) (max_over_time(up{job=\"snmp\", site=~\"$site\"}[1d]) == 1)) * 0 + 30\nor max by (instance, site) (upsOutputPercentLoad{job=\"snmp\", site=~\"$site\"} > 85) * 0 + 24\nor max by (instance, site) (upsBatteryTemperature{job=\"snmp\", site=~\"$site\"} > 40) * 0 + 23\nor max by (instance, site) ((upsOutputSource{job=\"snmp\", site=~\"$site\"} == 4) or (upsOutputSource{job=\"snmp\", site=~\"$site\"} == 9)) * 0 + 22\nor max by (instance, site) (upsAlarmsPresent{job=\"snmp\", site=~\"$site\"} > 0) * 0 + 21\n) > 0)), \"site\", \"без площадки\", \"site\", \"\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}} · {{site}}"
        }
      ]
    },
    {
