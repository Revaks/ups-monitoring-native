    {
      "id": 9,
      "type": "stat",
      "title": "Доступность ИБП (SNMP)",
      "description": "up = 1 — ИБП отвечает по SNMP, up = 0 — не отвечает. У недоступного ИБП пропадают все метрики ups*, поэтому именно по этой панели (и по алерту «ИБП недоступен по SNMP») видно отказ.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "НЕДОСТУПЕН", "color": "red", "index": 0 },
                "1": { "text": "OK", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "up{job=\"snmp\", instance=~\"$instance\"}",
          "legendFormat": "{{ups_name}} {{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
