# Пример настроек. Скопируйте в .env рядом (тот же каталог) и поправьте нужное:
#     cp .env.example .env
# Файл .env читает run.sh при запуске и передаёт значения сервисам.
# После правки .env нужен перезапуск: sudo systemctl restart ups-monitoring
# (или ./stop.sh && ./run.sh).
# Права: держите файл закрытым — chmod 600 .env

# ---------------------------------------------------------------------
# Доступ к Grafana (создаёт install.sh)
# ---------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# Уведомления об алертах (по умолчанию выключены)
# ---------------------------------------------------------------------
# Заполните оба значения, чтобы алерты уходили в Telegram:
#   TELEGRAM_BOT_TOKEN — токен бота от @BotFather
#   TELEGRAM_CHAT_ID   — id чата/канала (для группы/канала отрицательный)
# Пока пусто — правила алертов считаются, но сообщения не отправляются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# Сеть: что и где слушать
# ---------------------------------------------------------------------
# 0.0.0.0 — слушать все интерфейсы (по умолчанию);
# 127.0.0.1 — только локально. Порт 9116 (snmp_exporter) наружу открывать
# не стоит: это SNMP-прокси. Подробнее: docs/security.md
LISTEN_ADDR=0.0.0.0
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
# Внимание: при смене SNMP_EXPORTER_PORT поправьте prometheus.yml
# (replacement: localhost:<порт>) — run.sh предупредит об расхождении.
SNMP_EXPORTER_PORT=9116

# ---------------------------------------------------------------------
# Хранение истории Prometheus
# ---------------------------------------------------------------------
# Сколько держать историю: 15d, 90d, 1y, 5y... Пусто — умолчание Prometheus.
RETENTION_TIME=1y
# Ограничение по объёму (10GB, 500MB). Пусто — без ограничения.
RETENTION_SIZE=

# ---------------------------------------------------------------------
# Прочее
# ---------------------------------------------------------------------
# Пауза перед перезапуском упавшего сервиса (секунды, режим супервизора)
RESTART_DELAY=5
