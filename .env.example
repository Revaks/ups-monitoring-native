# Пример настроек. Скопируйте в .env рядом (тот же каталог) и поправьте нужное:
#     cp .env.example .env
# Файл .env читает run.sh при запуске и передаёт значения сервисам.
# После правки .env нужен перезапуск: sudo systemctl restart ups-monitoring
# (или ./stop.sh && ./run.sh).
# Права: держите файл закрытым — chmod 600 .env

# ---------------------------------------------------------------------
# Доступ к Grafana (создаёт install.sh)
# ---------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# Уведомления об алертах (по умолчанию выключены)
# ---------------------------------------------------------------------
# Заполните оба значения, чтобы алерты уходили в Telegram:
#   TELEGRAM_BOT_TOKEN — токен бота от @BotFather
#   TELEGRAM_CHAT_ID   — id чата/канала (для группы/канала отрицательный)
# Пока пусто — правила алертов считаются, но сообщения не отправляются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# Сеть: что и где слушать
# ---------------------------------------------------------------------
# 0.0.0.0 — слушать все интерфейсы (по умолчанию);
# 127.0.0.1 — только локально. Порт 9116 (snmp_exporter) наружу открывать
# не стоит: это SNMP-прокси. Подробнее: docs/security.md
LISTEN_ADDR=0.0.0.0
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
SNMP_EXPORTER_PORT=9116

# Сколько процессов snmp_exporter запускать (шардинг опроса).
# 1 — обычный случай: один процесс на порту SNMP_EXPORTER_PORT.
# 2 и больше — N процессов на портах SNMP_EXPORTER_PORT..+N-1, ИБП делятся
# между ними автоматически (hashmod), распределение детерминированное.
# Нужно, когда устройств много и один процесс не успевает за интервал опроса:
# см. docs/scaling.md. Максимум 8.
SNMP_SHARDS=1

# ---------------------------------------------------------------------
# Хранение истории Prometheus
# ---------------------------------------------------------------------
# Сколько держать историю: 15d, 90d, 1y, 5y... Пусто — умолчание Prometheus.
RETENTION_TIME=1y
# Ограничение по объёму (10GB, 500MB). Пусто — без ограничения.
RETENTION_SIZE=

# ---------------------------------------------------------------------
# Каталоги на дисках
# ---------------------------------------------------------------------
# По умолчанию и данные, и логи лежат в <каталог установки>/data.
# Если на сервере два диска, разложите их: историю — на один, логи — на другой
# (или наоборот). Каталоги создаются автоматически при запуске.
# Задаются и флагами установщика: --data-dir PATH --log-dir PATH
#
#   DATA_DIR  — история Prometheus (TSDB), база Grafana, pid-файлы;
#   LOG_DIR   — логи сервисов (*.log).
#
# Важно: если путь лежит на отдельном диске, диск должен быть смонтирован ДО
# запуска. run.sh предупредит, если каталог оказался на системном диске (/).
#DATA_DIR=/mnt/disk1/ups-monitoring
#LOG_DIR=/mnt/disk2/ups-monitoring-logs

# ---------------------------------------------------------------------
# Логи: ротация по размеру
# ---------------------------------------------------------------------
# run.sh поднимает фоновый ротатор: когда лог дорастает до LOG_MAX_SIZE, файл
# обрезается на месте, а его хвост (LOG_KEEP_PERCENT % от предела) остаётся —
# самое старое стирается, свежие записи сохраняются. Перезапуск не нужен.
# Размер проверяется каждые LOG_CHECK_INTERVAL секунд.
LOG_MAX_SIZE=10M
LOG_KEEP_PERCENT=10
LOG_CHECK_INTERVAL=10

# ---------------------------------------------------------------------
# Прочее
# ---------------------------------------------------------------------
# Пауза перед перезапуском упавшего сервиса (секунды, режим супервизора)
RESTART_DELAY=5
